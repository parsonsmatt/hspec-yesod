packages: .

-- Validate fragment authorization against https://github.com/yesodweb/yesod/pull/1931.
source-repository-package
  type: git
  location: https://github.com/yesodweb/yesod.git
  tag: 943c54b22f7d2e7d98b615979d11c729666d3943
  subdir: yesod-core

-- TEMP / TODO: remove once a fixed megaparsec is on Hackage.
-- megaparsec-9.8.0 fails to compile ("Variable not in scope" in
-- Text.Megaparsec.Stream); the cabal solver pulls it in transitively via
-- yesod-form. Pin below it so CI (and local builds) pick the last good 9.7.x.
-- Track for removal when megaparsec >= 9.8.1 (or a fixed 9.8.0 revision) ships.
constraints: megaparsec < 9.8

-- yesod-static 1.6.1.3 still uses memory's ByteArrayAccess, while crypton 1.1
-- and crypton-conduit 0.3 use ram. Keep the real EmbeddedStatic regression
-- fixture on the compatible pair until yesod-static completes that migration.
constraints: crypton < 1.1, crypton-conduit < 0.3
